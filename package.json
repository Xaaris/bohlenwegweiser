{
  "name": "bohlenwegweiser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finder for OSM-mapped Bohlenwege and boardwalk-like paths.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "go run ./tools/build-dataset",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/leaflet": "^1.9.20",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
